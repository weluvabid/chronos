---
import ChronosFooter from '@components/site/ChronosFooter.svelte';
import ChronosHeader from '@components/site/ChronosHeader.svelte';
import { ClientRouter } from 'astro:transitions';
import { createThemeScript } from '@weluvabid/iris/theme';
import '@styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Chronos — Browser time coordination engine',
  description = 'A centralized browser time coordination engine.',
} = Astro.props;

const themeBootstrap = createThemeScript();
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafaf8" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta property="og:site_name" content="Chronos" />
    <meta name="twitter:card" content="summary" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
    <script is:inline set:html={themeBootstrap} />
    <ClientRouter />
  </head>
  <body class="min-h-full scroll-smooth">
    <a
      href="#main-content"
      class="fixed left-4 top-4 z-[110] -translate-y-[calc(100%+1rem)] rounded-lg border border-border bg-background px-4 py-2 text-sm font-medium text-foreground transition-transform focus:translate-y-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring motion-reduce:transition-none"
    >
      Skip to content
    </a>
    <div class="mx-auto flex min-h-svh w-full max-w-6xl flex-col px-4 sm:px-6">
      <ChronosHeader client:load />
      <main id="main-content" tabindex="-1" class="min-h-0 flex-1 scroll-mt-28 py-10 sm:py-14">
        <slot />
      </main>
      <ChronosFooter />
    </div>
  </body>
</html>
